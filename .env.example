# Firebase console > Project settings > Your apps > Web app config (public values)
FIREBASE_PROJECT_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=
# Local Google Cloud credentials: gcloud auth application-default login
# Cloud Run: attach a service account authorized to manage Firebase Auth users.
# Never put a service account private key in public/ or Git.
ALLOWED_ORIGINS=https://orca-svg.github.io
PORT=4500
# Optional: Firebase Auth Emulator only on localhost, never in production
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# Development sample identities only; disabled when Firebase is configured or NODE_ENV=production
# DEV_SEED=1
