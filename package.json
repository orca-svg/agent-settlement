{
  "name": "agent-settlement",
  "private": true,
  "version": "0.0.1",
  "description": "돈 얘기는 각자의 AI 비서끼리 하고, 사람은 확인만 하는 정산 웹 앱",
  "type": "module",
  "imports": {
    "#src/*": "./src/*"
  },
